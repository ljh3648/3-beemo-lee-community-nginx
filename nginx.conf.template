user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # 도커 내부 DNS 사용
    resolver 127.0.0.11 valid=30s;
    resolver_timeout 5s;

    client_max_body_size 2G;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss;

    # HTTP -> HTTPS 리다이렉트
    server {
        listen 80;
        server_name ${DOMAIN} *.${DOMAIN};
        return 301 https://$server_name$request_uri;
    }

    # 메인 서버 설정
    server {
        listen 443 ssl;
        # 서브 도메인(dev 등)도 필요하면 변수로 처리 가능하나, 일단 메인 도메인 기준으로 예시 작성
        # 예: server_name dev.${DOMAIN};
        server_name dev.${DOMAIN};

        # SSL 인증서 경로에도 변수 적용
        ssl_certificate /app/ssl/letsencrypt/live/${DOMAIN}/fullchain.pem;
        ssl_certificate_key /app/ssl/letsencrypt/live/${DOMAIN}/privkey.pem;

        # 프론트엔드
        location / {
            set $upstream_ws http://${WS_HOST}:${WS_PORT};
            
            proxy_pass $upstream_ws;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # 백엔드 API
        location /api {
            set $upstream_was http://${API_SERVER_HOST}:${API_SERVER_PORT};
            
            proxy_pass $upstream_was;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
